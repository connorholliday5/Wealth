PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
# sandbox | development | production
PLAID_ENV=sandbox
PORT=8787
# Encrypts Plaid access tokens at rest in tokens.json. Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_chars

# Optional: enables the cloud AI advisor (for iPhones without Apple Intelligence).
# Get a key from https://console.anthropic.com. Leave unset to disable the cloud
# advisor entirely — the rule-based advisor and on-device chat still work.
ANTHROPIC_API_KEY=

# Strongly recommended before deploying anywhere reachable from the internet.
# Any random string (e.g. openssl rand -hex 16). Put the same value in the app
# under Settings > Server > Access Key. When unset, the API is unauthenticated.
APP_SHARED_SECRET=

# Note: PLAID_ENV=production connects to REAL banks and requires Plaid to approve
# your Production access request first (sandbox is fake data and needs no
# approval). Once approved, use your production PLAID_CLIENT_ID/PLAID_SECRET from
# the Plaid dashboard here. See the README "Going live with real bank accounts".
